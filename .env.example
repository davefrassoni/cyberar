DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-random-local-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:8063,http://localhost:8063
DATABASE_URL=sqlite:///db.sqlite3
CYBERAR_USER=admin
CYBERAR_PASSWORD=admin
# Login público separado (default admin/admin), permitido incluso en
# producción — a diferencia de CYBERAR_USER/PASSWORD arriba, que en
# producción no puede ser "admin" ni tener menos de 16 caracteres. Las
# misiones logueadas con este par nunca reservan el vuelo único compartido
# de DF AI (CAN o debriefing), para no interferir con la demo real.
CYBERAR_DEMO_ENABLED=true
CYBERAR_DEMO_USER=admin
CYBERAR_DEMO_PASSWORD=admin
CYBERAR_SESSION_SECONDS=7200
CYBERAR_DEMO_DURATION=150
CYBERAR_DEMO_MODE=true
# DF AI es opcional; si no está habilitado se usa un respaldo local explícito.
CYBERAR_AI_ENABLED=false
CYBERAR_AI_TIMEOUT=15
DF_AI_URL=http://127.0.0.1:8050
DF_AI_TOKEN=
DF_AI_PRIORITY=1
DF_AI_CALLBACK_TOKEN=
DF_AI_HOST=davefrassoni.com
CYBERAR_CAN_THRESHOLD=80
# Video de referencia de la cabina de control manual (proxeado por el backend).
CYBERAR_MANUAL_FEED_URL=https://davefrassoni.com/drive/s/Bz05g6mSo_zJqeky0zeJzg
